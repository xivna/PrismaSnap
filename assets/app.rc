// PrismaSnap exe 图标（资源管理器/任务栏显示；托盘图标在运行时单独加载）。
1 ICON "app.ico"

// exe 版本资源（资源管理器「属性 → 详细信息」可见）。
// 注意：FILEVERSION/PRODUCTVERSION 与 Cargo.toml 的 version 保持同步。
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "PrismaSnap - HDR screenshot tool for Windows 11"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "prismsnap"
      VALUE "OriginalFilename", "PrismaSnap.exe"
      VALUE "ProductName", "PrismaSnap"
      VALUE "ProductVersion", "1.0.0"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
